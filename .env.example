# Coolify / Docker Web Port
WEB_PORT=8080

# Docker ic portlari sabittir; bu ikisi yalnizca npm start icindir.
SOCKET_PORT=5050
BACKEND_PORT=4000
AUTH_PORT=4100

# Docker Phatsa authentication. For npm start use minigames_backend/.env.
PHATSA_URL=
PHATSA_API_KEY=
AUTH_ALLOWED_ORIGINS=

# Bos birakilirsa tarayici Origin ve Host eslesmesi zorunludur.
# Ornek: https://oyun.example.com
ALLOWED_ORIGINS=
