PORT=4100
HOST=127.0.0.1
NODE_ENV=development
# Project/panel origin, not the phatsa.com marketing website.
PHATSA_URL=
PHATSA_API_KEY=
PHATSA_TIMEOUT_MS=8000
# Comma-separated exact browser origins. Empty allows same-origin only.
AUTH_ALLOWED_ORIGINS=
# Only 1 when accessible exclusively through the trusted local gateway/nginx.
AUTH_TRUST_PROXY=0
AUTH_RATE_LIMIT=30
